        },
        "SectionC": {
          "name": "Section C",
          "questionType": "Structured Essay",
          "questions": "Choose 2 from 3",
          "marksEach": 20,
          "totalMarks": 40,
          "instructions": "Answer two questions from this section"
        }
      },
      "totalMarks": 100,
      "duration": "3 hours"
    }
  },
  "markingPrinciples": [
    "Award marks for any correct and valid response even if not in the marking scheme",
    "Do not penalise candidates for spelling or grammar errors unless the question specifically tests language",
    "For calculation questions, award marks for correct method even if the arithmetic answer is wrong (ECF - Error Carried Forward)",
    "For diagram questions, award marks for correctly labelled parts",
    "Reject vague or ambiguous answers that do not demonstrate understanding",
    "For Kiswahili questions, accept correct Swahili terminology equivalents"
  ],
