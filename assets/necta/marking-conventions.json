  "examStructure": {
    "CSEE": {
      "fullName": "Certificate of Secondary Education Examination",
      "form": "Form 4",
      "paperTypes": {
        "SectionA": {
          "name": "Section A",
          "questionType": "Multiple Choice",
          "questions": 30,
          "marksEach": 1,
          "totalMarks": 30,
          "instructions": "Choose the correct answer from A, B, C or D"
        },
        "SectionB": {
          "name": "Section B",
